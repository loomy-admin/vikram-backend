{
  "info": {
    "name": "Student Learning Platform - V1 API",
    "_postman_id": "c1f7a0e2-8501-447b-891d-e6b0a1d48c02",
    "description": "Complete Postman collection for Student Learning Platform Backend (Node.js, Express, PostgreSQL, Prisma)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "studentToken", "value": "", "type": "string" },
    { "key": "registrationToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0. System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "1. Student Authentication",
      "item": [
        {
          "name": "1.1 Request OTP (Email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/student/request-otp", "host": ["{{baseUrl}}"], "path": ["auth", "student", "request-otp"] }
          }
        },
        {
          "name": "1.2 Request OTP (Phone)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/student/request-otp", "host": ["{{baseUrl}}"], "path": ["auth", "student", "request-otp"] }
          }
        },
        {
          "name": "1.3 Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/student/verify-otp", "host": ["{{baseUrl}}"], "path": ["auth", "student", "verify-otp"] }
          }
        },
        {
          "name": "1.4 Register Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{registrationToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"schoolId\": 1,\n  \"classId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/students/register", "host": ["{{baseUrl}}"], "path": ["students", "register"] }
          }
        },
        {
          "name": "1.5 Activate Access Code (10-digit)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"2048591736\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/access-codes/activate", "host": ["{{baseUrl}}"], "path": ["access-codes", "activate"] }
          }
        },
        {
          "name": "1.6 Get My Profile & Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/student/me", "host": ["{{baseUrl}}"], "path": ["student", "me"] }
          }
        }
      ]
    },
