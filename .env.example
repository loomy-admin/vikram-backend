# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=student_learning_db
DB_PORT=3306

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OTP Authentication Settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ENABLE_DEV_OTP=true
DEV_STATIC_OTP=

# Storage Settings
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
BASE_URL=http://localhost:5000

# CORS Configuration
CORS_ORIGIN=*
