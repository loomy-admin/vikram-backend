# ============================================================
# Student Learning Platform — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to source control. It is already in .gitignore.
# ============================================================

# ─── Server ──────────────────────────────────────────────────
PORT=5000
# NODE_ENV must be "production" in production deployments.
# Setting this to "production" enables:
#   - Fail-fast on missing secrets (JWT_SECRET etc.)
#   - Automatic disabling of ENABLE_DEV_OTP (regardless of its value)
#   - Skipping sequelize.sync()
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=student_learning_db
DB_PORT=3306
# Set DB_SSL=true when connecting to a cloud-hosted MySQL (Aiven, PlanetScale, etc.)
DB_SSL=false

# Database Connection Pool (tune for your server's resources)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=20000
DB_POOL_IDLE=10000

# ─── JWT Authentication ───────────────────────────────────────
# REQUIRED in production. Must be a random string of at least 64 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRES_IN=7d

# ─── Admin Seeding ────────────────────────────────────────────
# On first boot with an empty DB, a single admin account is created.
# Change these values before first deploy in production.
ADMIN_SEED_EMAIL=admin@yourschool.com
ADMIN_SEED_PASSWORD=CHANGE_THIS_STRONG_ADMIN_PASSWORD

# ─── OTP Authentication ──────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ENABLE_DEV_OTP: Set to "true" only in local development.
# In production (NODE_ENV=production), this is ALWAYS forced to "false"
# regardless of what you set here, preventing the static-OTP backdoor.
ENABLE_DEV_OTP=true
DEV_STATIC_OTP=123456

# ─── Rate Limiting (requests per IP per hour) ─────────────────
RATE_OTP_REQUEST_PER_HOUR=5
RATE_OTP_VERIFY_PER_HOUR=10
RATE_ADMIN_LOGIN_PER_HOUR=20

# ─── Email / SMTP (for OTP email delivery) ───────────────────
# Supports: Gmail, SendGrid SMTP, AWS SES SMTP, any SMTP server.
#
# Gmail setup:
#   1. Enable 2FA on your Google account
#   2. Create an App Password at: https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
#
# SendGrid SMTP setup:
#   SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_SECURE=false
#   SMTP_USER=apikey, SMTP_PASS=<your-sendgrid-api-key>
#
# Leave blank to disable email OTP (students must use phone OTP only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ─── Twilio SMS (for OTP phone delivery) ─────────────────────
# Sign up at https://www.twilio.com to get credentials.
# Leave blank to disable SMS OTP (students must use email OTP only).
#
# TWILIO_FROM_NUMBER must be in E.164 format: +91XXXXXXXXXX (India), +1XXXXXXXXXX (US)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── File Storage ────────────────────────────────────────────
# "local" = store in the ./uploads directory on this server
# "s3" = store in AWS S3 (configure AWS_* vars below)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# This is the public base URL of the backend server.
# Used to construct URLs for locally-stored uploaded files.
# In production: set to your actual HTTPS domain, e.g. https://api.yourschool.com
BASE_URL=http://localhost:5000

# ─── CORS ─────────────────────────────────────────────────────
# In production: set to your admin dashboard domain only.
# Example: CORS_ORIGIN=https://admin.yourschool.com
# For multiple domains: CORS_ORIGIN=https://admin.yourschool.com,https://other.com
# NEVER use "*" in production for authenticated APIs.
CORS_ORIGIN=*

# ─── Cloudinary (image/video hosting) ────────────────────────
# Sign up at https://cloudinary.com (free tier available).
# Credentials found in: Cloudinary Console > Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ─── AWS S3 (optional, if STORAGE_TYPE=s3) ───────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
